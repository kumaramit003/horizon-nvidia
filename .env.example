# Copy to .env and fill in your keys. Docker Compose reads this automatically.

# ─── MongoDB ─────────────────────────────────────────────────────────────────
DATABASE_NAME=founderos

# ─── Nemotron (NVIDIA NIM or any OpenAI-compatible LLM endpoint) ─────────────
# For the hosted NVIDIA NIM:
#   NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#   Get a key at https://build.nvidia.com → integrate.
# For a self-hosted NIM running on the host machine, use host.docker.internal
# in NVIDIA_BASE_URL (e.g. http://host.docker.internal:8080/v1).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ─── ElevenLabs (TTS for Flora & Finn voices) ────────────────────────────────
# Optional — without these, the app runs in text-only mode.
# Get an API key at https://elevenlabs.io.
# Pick two distinct voice IDs from the ElevenLabs voice library.
# Flora is warm/feminine, Finn is grounded/analytical.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FLORA=
ELEVENLABS_VOICE_ID_FINN=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
