# Copy to .env and fill in your keys. Docker Compose reads this automatically.
# .env is gitignored — never commit real keys.

# ─── MongoDB ─────────────────────────────────────────────────────────────────
DATABASE_NAME=founderos

# ─── Nemotron via NVIDIA NIM (or any OpenAI-compatible LLM endpoint) ─────────
# Three common deployments:
#
# 1. Hosted NVIDIA NIM:
#      NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#      NVIDIA_API_KEY=nvapi-...
#
# 2. NIM on a remote machine reachable over LAN/SSH (this hackathon's setup):
#      NVIDIA_BASE_URL=http://10.18.216.38:8000/v1
#      NVIDIA_API_KEY=not-needed
#
# 3. NIM on the same host that runs Docker (Linux or Docker Desktop):
#      NVIDIA_BASE_URL=http://host.docker.internal:8000/v1
#      NVIDIA_API_KEY=not-needed
#    (host-gateway is configured for the backend service so this resolves.)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ─── ElevenLabs (Flora + Finn voices) ────────────────────────────────────────
# Get an API key at https://elevenlabs.io. Pick two distinct voice IDs from
# your voice library. Flora is warm/feminine; Finn is grounded/analytical.
# Without these, /api/voice/tts returns 503 and the UI falls back to text-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FLORA=
ELEVENLABS_VOICE_ID_FINN=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ─── Ports note ──────────────────────────────────────────────────────────────
# Frontend  → http://localhost:3001  (Docker)
# Backend   → http://localhost:8001  (Docker; internal container port is 8000)
# MongoDB   → localhost:27017
#
# The backend's host port is 8001 (not 8000) so it doesn't collide with a
# NIM running on the same host at :8000.
