MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=founderos

# Point to your local NIM / Nemotron server
NVIDIA_BASE_URL=http://localhost:8080/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Only needed if using NVIDIA cloud API (https://integrate.api.nvidia.com/v1)
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dedicated Finn endpoint (optional). When set, Finn uses this OpenAI-compatible
# server while Flora keeps using the NIM/Nemotron config above. Inside Docker,
# use host.docker.internal to reach a server bound to 127.0.0.1 on the host.
# FINN_BASE_URL=http://host.docker.internal:18789/v1
# FINN_API_KEY=your_finn_api_key
# FINN_MODEL=openclaw

# Google Sign-In. Create an OAuth 2.0 Web Client ID in Google Cloud Console.
GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id
