MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=founderos

# Point to your local NIM / Nemotron server
NVIDIA_BASE_URL=http://localhost:8080/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Only needed if using NVIDIA cloud API (https://integrate.api.nvidia.com/v1)
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dedicated Finn endpoint (optional). When set, Finn uses this OpenAI-compatible
# server while Flora keeps using the NIM/Nemotron config above.
#
# If the Finn gateway is bound to 127.0.0.1 on the host, containers can't reach
# it directly — use the finn-proxy socat relay (docker-compose) and point at
# port 18790 via host.docker.internal:
# FINN_BASE_URL=http://host.docker.internal:18790/v1
# FINN_API_KEY=your_finn_api_key
# FINN_MODEL=openclaw
#
# If the gateway already listens on 0.0.0.0, you can skip finn-proxy and use
# its real port directly, e.g. http://host.docker.internal:18789/v1

# Google Sign-In. Create an OAuth 2.0 Web Client ID in Google Cloud Console.
GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id
